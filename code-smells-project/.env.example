# Copie para .env (não versionado) e ajuste. Todos os valores têm default seguro.
SECRET_KEY=troque-esta-chave
DEBUG=false
HOST=127.0.0.1
PORT=5000
DB_PATH=loja.db
APP_ENV=development
LOG_LEVEL=INFO
# Rotas administrativas perigosas (respondem 403 enquanto estiverem em false)
ADMIN_SQL_ENABLED=false
ADMIN_RESET_ENABLED=false
