# Copie para .env (nunca versione o .env real) e rode: node --env-file=.env src/app.js
PORT=3000
# Caminho do SQLite. ":memory:" recria schema e seeds a cada boot.
DB_PATH=:memory:
# Credencial do gateway de pagamento (vazia por padrão; o gateway é simulado).
PAYMENT_GATEWAY_KEY=
# Prefixo de cartão aprovado pelo gateway simulado.
APPROVED_CARD_PREFIX=4
# error | warn | info | debug
LOG_LEVEL=info
