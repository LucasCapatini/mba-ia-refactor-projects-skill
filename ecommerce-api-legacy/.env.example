# Copie para .env e rode com: node --env-file=.env src/app.js
PORT=3000
HOST=127.0.0.1
# ':memory:' (padrão) recria o banco e os seeds a cada boot
DB_PATH=:memory:
# Gateway simulado: cartões que começam com este prefixo são aprovados
APPROVED_CARD_PREFIX=4
# error | warn | info | debug
LOG_LEVEL=info
